{
    "name": "@vs-flow/tb-openalea",
    "description": "Visual Studio Flow toolbox wrapping the openalea library.",
    "version": "0.1.0-wip",
    "author": "reinisch.gui@gmail.com",
    "license": "MIT",
    "homepage": "https://github.com/vs-flow/tb-openalea#README.md",
    "main": "./dist/@vs-flow/tb-openalea.js",
    "files": [
        "dist",
        "assets"
    ],
    "scripts": {
        "clean": "del-cli dist",
        "setup": "python .w3nest/setup.py",
        "build": "yarn build:prod",
        "pre-build": "yarn clean",
        "post-build": "del-cli dist/src/tests",
        "build:dev": "yarn pre-build && webpack --mode development && yarn post-build",
        "build:prod": "yarn pre-build && webpack --mode production && yarn post-build",
        "lint-check": "yarn lint-prettier-check && yarn lint-eslint-check",
        "lint-prettier-check": "prettier --check ./src",
        "lint-prettier-write": "prettier --write ./src",
        "lint-eslint-check": "eslint ./src",
        "test": "jest -i",
        "test-coverage": "jest -i --collect-coverage",
        "doc": "npx tsx .w3nest/doc.ts",
        "publish-npm-public": "yarn build:prod && yarn test-coverage && yarn publish --access public"
    },
    "exports": {
        ".": {
            "default": "./dist/@vs-flow/tb-openalea.js",
            "types": "./dist/src/lib/toolbox.d.ts",
            "webpm": {
                "dependencies": [
                    "@vs-flow/core"
                ],
                "aliases": []
            }
        },
        "./quakingAspen": {
            "default": "./dist/quakingAspen.js",
            "types": "./dist/src/lib/quaking-aspen.module.d.ts",
            "webpm": {
                "dependencies": [
                    "@vs-flow/core",
                    "rxjs",
                    "three"
                ],
                "aliases": []
            }
        },
        "./defaultMtg": {
            "default": "./dist/defaultMtg.js",
            "types": "./dist/src/lib/default-mtg.module.d.ts",
            "webpm": {
                "dependencies": [
                    "@vs-flow/core",
                    "rxjs",
                    "three"
                ],
                "aliases": []
            }
        },
        "./weberMtg": {
            "default": "./dist/weberMtg.js",
            "types": "./dist/src/lib/weber-mtg.module.d.ts",
            "webpm": {
                "dependencies": [
                    "@vs-flow/core",
                    "rxjs",
                    "three"
                ],
                "aliases": []
            }
        },
        "./mtgPlot": {
            "default": "./dist/mtgPlot.js",
            "types": "./dist/src/lib/mtg-plot.module.d.ts",
            "webpm": {
                "dependencies": [
                    "@vs-flow/core",
                    "rxjs",
                    "three"
                ],
                "aliases": []
            }
        }
    },
    "dependencies": {
        "@mkdocs-ts/code-api": "^0.2.3",
        "@mkdocs-ts/notebook": "^0.1.5",
        "@types/three": "^0.152.0",
        "@vs-flow/core": "^0.4.0",
        "@w3nest/webpm-client": "^0.1.5",
        "mkdocs-ts": "^0.5.2",
        "rx-vdom": "^0.1.7",
        "rxjs": "^7.8.1",
        "three": "^0.152.0"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^24.3.0",
        "@types/webpack": "^5.28.5",
        "del-cli": "^6.0.0",
        "eslint": "9.34.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-jest": "^29.0.1",
        "isomorphic-fetch": "^3.0.0",
        "jest": "^30.1.2",
        "jest-environment-jsdom": "^30.1.2",
        "jest-junit": "^16.0.0",
        "prettier": "^3.6.2",
        "prettier-plugin-properties": "^0.3.0",
        "ts-jest": "^29.4.1",
        "ts-loader": "9.5.4",
        "ts-node": "10.9.2",
        "tsx": "^4.20.5",
        "typedoc": "^0.28.12",
        "typescript": "5.9.2",
        "typescript-eslint": "8.41.0",
        "webpack": "^5.101.3",
        "webpack-bundle-analyzer": "^4.10.2",
        "webpack-cli": "6.0.1"
    },
    "webpm": {
        "kind": "esm",
        "dependencies": {
            "@mkdocs-ts/code-api": "^0.2.3",
            "@mkdocs-ts/notebook": "^0.1.5",
            "@vs-flow/core": "^0.4.0",
            "@w3nest/webpm-client": "^0.1.5",
            "mkdocs-ts": "^0.5.2",
            "rxjs": "^7.8.1",
            "three": "^0.152.0"
        }
    },
    "webpack": {
        "root": "src",
        "apiVersion": "01",
        "main": "./lib/toolbox.ts",
        "additionalEntries": {
            "quakingAspen": "./lib/quaking-aspen.module.ts",
            "defaultMtg": "./lib/default-mtg.module.ts",
            "weberMtg": "./lib/weber-mtg.module.ts",
            "mtgPlot": "./lib/mtg-plot.module.ts"
        },
        "externals": {
            "@mkdocs-ts/code-api": [
                "@mkdocs-ts/code-api_APIv02"
            ],
            "@mkdocs-ts/notebook": [
                "@mkdocs-ts/notebook_APIv01"
            ],
            "@vs-flow/core": [
                "@vs-flow/core_APIv04"
            ],
            "@w3nest/webpm-client": [
                "@w3nest/webpm-client_APIv01"
            ],
            "mkdocs-ts": [
                "mkdocs-ts_APIv05"
            ],
            "rxjs": [
                "rxjs_APIv7"
            ],
            "three": [
                "three_APIv0152"
            ]
        }
    }
}
